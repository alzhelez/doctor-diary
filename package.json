{
  "name": "doctor-diary",
  "version": "1.0.0",
  "private": true,
  "description": "Дневник для врача: надиктовываешь симптомы голосом, перед приёмом получаешь короткую сводку для врача",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "author": "Aleksandr Zheleznoy",
  "license": "MIT",
  "dependencies": {
    "@fontsource/golos-text": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
